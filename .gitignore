# secrets — never commit (object-store credentials, bearer tokens, embedding API keys)
.env*

# local cluster / graph state created by `omnigraph cluster apply` with a file-backed root
__cluster/
graphs/

# corpus pipeline — kept on the maintainer's machine, not part of the published graph:
# raw transcripts, per-talk extraction notes, conversion scripts, fragments, work files
transcripts/
extraction/
seed-work/
seed.jsonl
seed.md

# local notes and generated artifacts
RUNBOOK.md
EXPLORER-DESIGN.md
report.md
skill/

# bench: generated corpus, raw run traces, reader-only omnigraph config
bench/corpus/
bench/runs/
bench/.omnigraph-home/
.venv/

__pycache__/
.DS_Store

# bench: local file-backed graph (config copy, cluster state, tokens, embedded chunks)
bench/.graph/
bench/runs-clean/
