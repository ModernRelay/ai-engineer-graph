// Pattern reads

query get_pattern($slug: String)
@description("Pattern card: name, kind, brief, description, evolution")
{
    match {
        $p: Pattern { slug: $slug }
    }
    return { $p.slug, $p.name, $p.kind, $p.brief, $p.description, $p.evolution }
}

query patterns_by_kind($kind: String)
@description("Patterns of one kind (challenge, disruption, dynamic), by name")
{
    match {
        $p: Pattern { kind: $kind }
    }
    return { $p.slug, $p.name, $p.brief }
    order { $p.name }
}

query search_patterns($q: String)
@description("Full-text search over pattern names")
{
    match {
        $p: Pattern
        search($p.name, $q)
    }
    return { $p.slug, $p.name, $p.kind, $p.brief }
}

// Pattern <- Signal (what signals form this pattern?)

query pattern_signals($slug: String)
@description("Signals that support this pattern (FormsPattern), newest first; signal_evidence has the transcript passage behind each")
{
    match {
        $p: Pattern { slug: $slug }
        $s formsPattern $p
    }
    return { $s.slug, $s.name, $s.brief, $s.stagingTimestamp }
    order { $s.stagingTimestamp desc }
}

// Pattern -> Pattern

query pattern_drives($slug: String)
@description("Patterns this pattern drives (DrivesPattern)")
{
    match {
        $p: Pattern { slug: $slug }
        $p drivesPattern $target
    }
    return { $target.slug, $target.name, $target.kind, $target.brief }
}

query pattern_relies_on($slug: String)
@description("Patterns this pattern relies on (ReliesOnPattern)")
{
    match {
        $p: Pattern { slug: $slug }
        $p reliesOnPattern $dep
    }
    return { $dep.slug, $dep.name, $dep.kind, $dep.brief }
}

query pattern_contradicts($slug: String)
@description("Patterns this pattern is in tension with (ContradictsToPattern)")
{
    match {
        $p: Pattern { slug: $slug }
        $p contradictsToPattern $target
    }
    return { $target.slug, $target.name, $target.kind, $target.brief }
}

// Pattern <- Element

query pattern_elements($slug: String)
@description("Elements that exemplify this pattern (ExemplifiesPattern)")
{
    match {
        $p: Pattern { slug: $slug }
        $e exemplifiesPattern $p
    }
    return { $e.slug, $e.name, $e.kind, $e.brief }
}

// Pattern <- Insight

query pattern_insights($slug: String)
@description("Insights that highlight this pattern (HighlightsPattern)")
{
    match {
        $p: Pattern { slug: $slug }
        $i highlightsPattern $p
    }
    return { $i.slug, $i.name, $i.brief }
}

// Pattern evidence split (audit 2026-09-13)

query pattern_signals_by_evidence($slug: String, $evidenceType: String)
@description("Supporting signals of one evidence type: first_party (the speaker's own company is the subject), third_party or unattributed")
{
    match {
        $p: Pattern { slug: $slug }
        $s: Signal { evidenceType: $evidenceType }
        $s formsPattern $p
    }
    return { $s.slug, $s.name, $s.brief, $s.stagingTimestamp }
    order { $s.stagingTimestamp desc }
}

// Counters split by polarity: "contradiction" refutes the thesis, "boundary" limits its scope.

query pattern_counters_by_polarity($slug: String, $polarity: String)
@description("Counter-signals of one polarity: contradiction refutes the thesis, boundary limits its scope")
{
    match {
        $p: Pattern { slug: $slug }
        $s $e:contradictsPattern $p
        $e.polarity = $polarity
    }
    return { $s.slug, $s.name, $s.brief, $e.polarity }
}

// Contested claims in one read: every refuting counter-signal (polarity contradiction,
// not a boundary condition) with the pattern it refutes, its talk, the transcript passages
// it was extracted from, and how many signals support the pattern. Counting distinct
// signals per pattern gives the ranking; `quote` is verbatim chunk text.

query contested_claims()
@description("Every claim that is directly contradicted: the pattern (thesis) and its supporting-signal count, each contradicting signal with its talk and the verbatim transcript passage behind it; most-supported patterns first")
{
    match {
        $p: Pattern
        $s $e:contradictsPattern $p
        $e.polarity = "contradiction"
        $s spottedInArtifact $a
        $s $v:evidencedByChunk $c
        $f formsPattern $p
    }
    return { $p.slug as pattern, $p.name as thesis, $s.slug as signal, $s.name as pushback, $a.slug as talk, $a.name as title, $v.score as score, $c.text as quote, count($f) as support }
    order { support desc, pattern, signal, score desc }
}

// The talks behind a pattern, by how many of their signals support it.

query pattern_support_talks($slug: String)
@description("The 10 talks with the most signals supporting a pattern, with the signal count")
{
    match {
        $p: Pattern { slug: $slug }
        $s formsPattern $p
        $s spottedInArtifact $a
    }
    return { $a.slug as talk, $a.name as title, count($s) as signals }
    order { signals desc }
    limit 10
}

// The pattern layer: every pattern-to-pattern edge, one query per edge type.

query pattern_layer_relies()
@description("Every ReliesOnPattern edge between patterns")
{
    match { $a: Pattern $a reliesOnPattern $b }
    return { $a.slug as from, $b.slug as to }
    order { $a.slug }
}

query pattern_layer_drives()
@description("Every DrivesPattern edge between patterns")
{
    match { $a: Pattern $a drivesPattern $b }
    return { $a.slug as from, $b.slug as to }
    order { $a.slug }
}

query pattern_layer_contradicts()
@description("Every ContradictsToPattern edge between patterns")
{
    match { $a: Pattern $a contradictsToPattern $b }
    return { $a.slug as from, $b.slug as to }
    order { $a.slug }
}
