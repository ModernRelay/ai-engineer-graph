// Signal reads

query get_signal($slug: String) {
    match {
        $s: Signal { slug: $slug }
    }
    return { $s.slug, $s.name, $s.brief, $s.description, $s.domain, $s.stagingTimestamp }
}

query recent_signals() {
    match {
        $s: Signal
    }
    return { $s.slug, $s.name, $s.brief, $s.domain, $s.stagingTimestamp }
    order { $s.stagingTimestamp desc }
    limit 50
}

query search_signals($q: String) {
    match {
        $s: Signal
        search($s.name, $q)
    }
    return { $s.slug, $s.name, $s.brief }
}

// Signal -> Pattern (core analytical)

query signal_patterns($slug: String) {
    match {
        $s: Signal { slug: $slug }
        $s formsPattern $p
    }
    return { $p.slug, $p.name, $p.kind, $p.brief }
}

query signal_contradictions($slug: String) {
    match {
        $s: Signal { slug: $slug }
        $s contradictsPattern $p
    }
    return { $p.slug, $p.name, $p.kind, $p.brief }
}

// Signal -> Element

query signal_elements($slug: String) {
    match {
        $s: Signal { slug: $slug }
        $s onElement $e
    }
    return { $e.slug, $e.name, $e.kind, $e.brief }
}

// Signal -> Company

query signal_companies($slug: String) {
    match {
        $s: Signal { slug: $slug }
        $s relevantCompany $c
    }
    return { $c.slug, $c.name, $c.brief }
}

// Signal provenance

query signal_sources($slug: String) {
    match {
        $s: Signal { slug: $slug }
        $s spottedInArtifact $a
    }
    return { $a.slug, $a.name, $a.artifactType, $a.link }
}

// Signal -> Chunk (audit 2026-09-13): the transcript passages a signal paraphrases, best match first.
// score is the cosine similarity between the signal brief and the chunk text.

query signal_evidence($slug: String) {
    match {
        $s: Signal { slug: $slug }
        $s $e:evidencedByChunk $c
        $c partOfArtifact $a
    }
    return { $c.slug, $e.score, $a.slug as artifact, $c.text }
    order { $e.score desc }
    limit 5
}

// Signals by evidence type (first_party = the speaker's own company is the subject).

query signals_by_evidence_type($evidenceType: String) {
    match {
        $s: Signal { evidenceType: $evidenceType }
    }
    return { $s.slug, $s.name, $s.stagingTimestamp }
    order { $s.stagingTimestamp desc }
    limit 200
}
