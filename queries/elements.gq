// Element reads

query get_element($slug: String)
@description("Element card: name, kind, brief, description, category, domain")
{
    match {
        $e: Element { slug: $slug }
    }
    return { $e.slug, $e.name, $e.kind, $e.brief, $e.description, $e.category, $e.domain }
}

query elements_by_kind($kind: String)
@description("Elements of one kind (product, technology, framework, concept, ops), by name")
{
    match {
        $e: Element { kind: $kind }
    }
    return { $e.slug, $e.name, $e.brief, $e.category }
    order { $e.name }
}

query search_elements($q: String)
@description("Full-text search over element names")
{
    match {
        $e: Element
        search($e.name, $q)
    }
    return { $e.slug, $e.name, $e.kind, $e.brief }
}

// Element -> Element

query element_enables($slug: String)
@description("Elements this element enables (EnablesElement)")
{
    match {
        $e: Element { slug: $slug }
        $e enablesElement $target
    }
    return { $target.slug, $target.name, $target.kind, $target.brief }
}

query element_uses($slug: String)
@description("Elements this element depends on (UsesElement)")
{
    match {
        $e: Element { slug: $slug }
        $e usesElement $dep
    }
    return { $dep.slug, $dep.name, $dep.kind, $dep.brief }
}

// Element -> Pattern

query element_patterns($slug: String)
@description("Patterns this element exemplifies (ExemplifiesPattern)")
{
    match {
        $e: Element { slug: $slug }
        $e exemplifiesPattern $p
    }
    return { $p.slug, $p.name, $p.kind, $p.brief }
}

// Element <- Signal

query element_signals($slug: String)
@description("Signals about this element (OnElement), newest first")
{
    match {
        $e: Element { slug: $slug }
        $s onElement $e
    }
    return { $s.slug, $s.name, $s.brief, $s.stagingTimestamp }
    order { $s.stagingTimestamp desc }
}

// Element -> Company

query element_developer($slug: String)
@description("Companies that develop this element (DevelopedByCompany)")
{
    match {
        $e: Element { slug: $slug }
        $e developedByCompany $c
    }
    return { $c.slug, $c.name, $c.brief }
}

// Element provenance

query element_sources($slug: String)
@description("Talks and articles this element was identified in (IdentifiedInArtifact)")
{
    match {
        $e: Element { slug: $slug }
        $e identifiedInArtifact $a
    }
    return { $a.slug, $a.name, $a.artifactType, $a.link }
}
