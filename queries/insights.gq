// Insight reads

query get_insight($slug: String)
@description("Insight card: name, brief, description, importance")
{
    match {
        $i: Insight { slug: $slug }
    }
    return { $i.slug, $i.name, $i.brief, $i.description, $i.importance }
}

query search_insights($q: String)
@description("Full-text search over insight names")
{
    match {
        $i: Insight
        search($i.name, $q)
    }
    return { $i.slug, $i.name, $i.brief }
}

// Insight -> Pattern

query insight_patterns($slug: String)
@description("Patterns this insight highlights (HighlightsPattern)")
{
    match {
        $i: Insight { slug: $slug }
        $i highlightsPattern $p
    }
    return { $p.slug, $p.name, $p.kind, $p.brief }
}

// Insight -> Element

query insight_elements($slug: String)
@description("Elements this insight relies on (ReliesOnElement)")
{
    match {
        $i: Insight { slug: $slug }
        $i reliesOnElement $e
    }
    return { $e.slug, $e.name, $e.kind, $e.brief }
}
