// KnowHow reads

query get_knowhow($slug: String)
@description("KnowHow card: name, brief, description, guidelines, context, url")
{
    match {
        $k: KnowHow { slug: $slug }
    }
    return { $k.slug, $k.name, $k.brief, $k.description, $k.guidelines, $k.context, $k.url }
}

query recent_knowhow()
@description("The 50 most recent KnowHow practices")
{
    match {
        $k: KnowHow
    }
    return { $k.slug, $k.name, $k.brief, $k.stagingTimestamp }
    order { $k.stagingTimestamp desc }
    limit 50
}

query search_knowhow($q: String)
@description("Full-text search over KnowHow names")
{
    match {
        $k: KnowHow
        search($k.name, $q)
    }
    return { $k.slug, $k.name, $k.brief }
}

// KnowHow -> Element

query knowhow_elements($slug: String)
@description("Elements this practice references (ReferencesElement)")
{
    match {
        $k: KnowHow { slug: $slug }
        $k referencesElement $e
    }
    return { $e.slug, $e.name, $e.kind, $e.brief }
}

// KnowHow provenance

query knowhow_sources($slug: String)
@description("Talks and articles this practice was sourced from (SourcedFromArtifact)")
{
    match {
        $k: KnowHow { slug: $slug }
        $k sourcedFromArtifact $a
    }
    return { $a.slug, $a.name, $a.artifactType, $a.link }
}
